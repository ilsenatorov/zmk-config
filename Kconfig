DT_COMPAT_ZMK_BEHAVIOR_BATTERY_TYPE := zmk,behavior-battery-type

config ZMK_BEHAVIOR_BATTERY_TYPE
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_BATTERY_TYPE))
    # Fetching only (not ..._PROXY): the central learns the peripheral's level
    # internally, without exposing the second GATT Battery Service that trips
    # the BlueZ bug described in config/totem.conf.
    select ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING if ZMK_SPLIT_BLE && ZMK_SPLIT_ROLE_CENTRAL
